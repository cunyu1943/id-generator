{
  "name": "id-generator",
  "version": "1.0.0",
  "private": true,
  "description": "身份证正反面演示图生成器（离线桌面工具，强制水印，仅用于 UI 原型/测试 Mock/教学示例）",
  "main": "./out/main/index.js",
  "author": "demo",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "gen:assets": "node scripts/gen-assets.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,json,scss,css,html}\" \"*.{json,md,yml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,json,scss,css,html}\""
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "element-plus": "^2.14.7",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "pinia": "^4.0.3",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.12"
  }
}
